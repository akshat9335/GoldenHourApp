# ============================================================
# Golden Hour backend - environment variables
# Copy this file to `.env` and fill in real values locally.
# NEVER commit the real `.env` file.
# ============================================================

# --- CORE (required for the backend to boot) ---
PORT=5000
NODE_ENV=development

# --- Firebase Admin (optional until auth/data features are implemented) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key on one line with \n for newlines, e.g.:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIENy...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# --- Gemini (optional until AI module is implemented) ---
GEMINI_API_KEY=

# --- Google Maps (optional until location module is implemented) ---
GOOGLE_MAPS_SERVER_API_KEY=

# --- Twilio (optional until notifications module is implemented) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
