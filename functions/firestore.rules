// Firestore Security Rules for the Teleconsultation Module.
// Paste this into Firebase Console → Firestore → Rules tab.
//
// Mirrors the access checks in src/services/teleconsultation.ts → userHasAccess():
// a user may read/write a consultation only if their auth.uid matches the
// document's patientId (for patients) or doctorId (for doctors).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /teleconsultations/{consultationId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.patientId ||
         request.auth.uid == resource.data.doctorId);
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.patientId ||
         request.auth.uid == resource.data.doctorId);

      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/
            teleconsultations/$(consultationId)).data.patientId ||
           request.auth.uid == get(/databases/$(database)/documents/
            teleconsultations/$(consultationId)).data.doctorId);
      }

      match /notes/{noteId} {
        allow read: if request.auth != null &&
          (request.auth.uid == get(/databases/$(database)/documents/
            teleconsultations/$(consultationId)).data.patientId ||
           request.auth.uid == get(/databases/$(database)/documents/
            teleconsultations/$(consultationId)).data.doctorId);
        allow write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/
            teleconsultations/$(consultationId)).data.doctorId;
      }

      match /prescriptions/{prescriptionId} {
        allow read, write: if request.auth != null &&
          request.auth.uid == get(/databases/$(database)/documents/
            teleconsultations/$(consultationId)).data.doctorId;

        match /items/{itemId} {
          allow read: if request.auth != null &&
            (request.auth.uid == get(/databases/$(database)/documents/
              teleconsultations/$(consultationId)).data.patientId ||
             request.auth.uid == get(/databases/$(database)/documents/
              teleconsultations/$(consultationId)).data.doctorId);
          allow write: if request.auth != null &&
            request.auth.uid == get(/databases/$(database)/documents/
              teleconsultations/$(consultationId)).data.doctorId;
        }
      }
    }

    match /rooms/{roomId}/signals/{signalId} {
      allow read, write: if request.auth != null;
    }

    match /escalations/{escId} {
      allow create: if request.auth != null;
      allow read:  if request.auth != null;
      allow update, delete: if false;
    }
  }
}
