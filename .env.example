# ============================================================
# Golden Hour Frontend - Environment Variables
# Copy this file to `.env` in the project root for local development.
# NEVER commit the real `.env` file to version control.
# ============================================================

# --- API Configuration ---
# For local web development: http://localhost:5000
# For physical Android / iOS devices on the same Wi-Fi network: http://<YOUR_LOCAL_IP>:5000 (e.g., http://192.168.1.50:5000)
# For remote/tunnel testing: https://<tunnel-id>.ngrok-free.app
EXPO_PUBLIC_API_URL=http://localhost:5000

# --- Firebase Client Configuration (Web SDK) ---
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web App
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Twilio / Cloud Functions Configuration (For Video & TURN/STUN) ---
# Obtain from Twilio Console
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
